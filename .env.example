# Kali-Mind Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# xAI Grok
XAI_API_KEY=

# Moonshot / Kimi
KIMI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Groq
GROQ_API_KEY=

# Cohere
COHERE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Default provider (openai, anthropic, ollama, grok, gemini, groq, etc.)
KALI_MIND_DEFAULT_PROVIDER=ollama

# Database path (default: ~/.kali-mind/kali_mind.db)
KALI_MIND_DB_PATH=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Notifications (Feature #33)
KALI_MIND_TELEGRAM_TOKEN=
KALI_MIND_TELEGRAM_CHAT_ID=
KALI_MIND_SLACK_WEBHOOK=
KALI_MIND_NOTIFY_SEVERITY=high

# Sandbox high-risk tools with firejail/bwrap when installed
# KALI_MIND_SANDBOX_MODE=true
# Signed plugins are required by default. Set false only for isolated local development.
KALI_MIND_REQUIRE_SIGNED_PLUGINS=true
# Keep this key stable and secret if signing plugins with HMAC.
# KALI_MIND_PLUGIN_SIGNING_KEY=
# Metasploit RPC password (optional; pass password explicitly in Python if preferred).
# MSF_RPC_PASSWORD=

# Optional: pip install keyring  for OS secret store

# Multi-model role assignments (Feature #22)
# Uncomment and set to assign specific providers to roles
# KALI_MIND_PLANNER_PROVIDER=openai
# KALI_MIND_ANALYST_PROVIDER=anthropic
# KALI_MIND_PARSER_PROVIDER=ollama
# KALI_MIND_REPORTER_PROVIDER=kimi
